<?xml version="1.0"?>
<!--
  Sorting cell world (Gazebo Fortress).
  This is a template: the dollar-brace placeholders are filled in by the bringup launch file
  from the selected scenario (see sorting_cell_bringup/config/scenarios/).

  World frame: floor at z = 0, robot base on a pedestal at (0, 0, 0.75),
  conveyor along +x at y = 0.60 with its surface at z = 0.72,
  four bins at y = -0.50, overhead RGB-D camera above the pick zone.
-->
<sdf version="1.9">
  <world name="sorting_cell">
    <physics name="2ms" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system" name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system" name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system" name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="ignition-gazebo-sensors-system" name="ignition::gazebo::systems::Sensors">
      <render_engine>${render_engine}</render_engine>
    </plugin>

    <plugin filename="SortingCellSystem" name="sorting_cell::SortingCellSystem">
      <robot_model>ur5</robot_model>
      <tcp_link>wrist_3_link</tcp_link>
      <!-- wrist_3_link -> tcp (fingertip centre); must match the URDF -->
      <tcp_offset>0 0 ${tcp_offset_z} 0 0 0</tcp_offset>
      <attach_tolerance>0.03</attach_tolerance>
      <slip_probability>${slip_probability}</slip_probability>

      <belt_min_x>-1.6</belt_min_x>
      <belt_max_x>1.6</belt_max_x>
      <belt_center_y>0.6</belt_center_y>
      <belt_width>0.3</belt_width>
      <belt_surface_z>0.72</belt_surface_z>
      <belt_speed>${belt_speed}</belt_speed>

      <spawn_enabled>${spawn_enabled}</spawn_enabled>
      <spawn_x>-1.45</spawn_x>
      <spawn_interval>${spawn_interval}</spawn_interval>
      <spawn_y_jitter>0.07</spawn_y_jitter>
      <defect_ratio>${defect_ratio}</defect_ratio>
      <touching_probability>${touching_probability}</touching_probability>
      <scale_jitter>${scale_jitter}</scale_jitter>
      <colour_jitter>${colour_jitter}</colour_jitter>
      <max_parts>${max_parts}</max_parts>
      <seed>${seed}</seed>
      <types>${part_types}</types>

      <bin><name>bin_cube</name><center>-0.36 -0.5</center><size>0.2 0.2</size><z_top>0.64</z_top></bin>
      <bin><name>bin_cylinder</name><center>-0.12 -0.5</center><size>0.2 0.2</size><z_top>0.64</z_top></bin>
      <bin><name>bin_hex_nut</name><center>0.12 -0.5</center><size>0.2 0.2</size><z_top>0.64</z_top></bin>
      <bin><name>bin_reject</name><center>0.36 -0.5</center><size>0.2 0.2</size><z_top>0.64</z_top></bin>
    </plugin>

    <scene>
      <ambient>${ambient} ${ambient} ${ambient} 1</ambient>
      <background>0.75 0.8 0.85 1</background>
      <shadows>true</shadows>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>${sun} ${sun} ${sun} 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>${sun_direction}</direction>
    </light>
    <light type="point" name="cell_lamp">
      <pose>0.3 0.3 2.4 0 0 0</pose>
      <diffuse>${lamp} ${lamp} ${lamp} 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>8</range><constant>0.6</constant><linear>0.05</linear><quadratic>0.01</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="floor">
      <static>true</static>
      <link name="link">
        <collision name="c"><geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry></collision>
        <visual name="v">
          <geometry><plane><normal>0 0 1</normal><size>20 20</size></plane></geometry>
          <material><ambient>0.45 0.47 0.5 1</ambient><diffuse>0.55 0.57 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Robot pedestal: the UR5 base sits on top at z = 0.75 -->
    <model name="pedestal">
      <static>true</static>
      <pose>0 0 0.375 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.3 0.3 0.75</size></box></geometry></collision>
        <visual name="v">
          <geometry><box><size>0.3 0.3 0.75</size></box></geometry>
          <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Conveyor: belt surface at z = 0.72, 3.2 m long, 0.3 m wide -->
    <model name="conveyor">
      <static>true</static>
      <pose>0 0.6 0 0 0 0</pose>
      <link name="link">
        <collision name="belt">
          <pose>0 0 0.695 0 0 0</pose>
          <geometry><box><size>3.2 0.3 0.05</size></box></geometry>
          <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
        </collision>
        <visual name="belt">
          <pose>0 0 0.695 0 0 0</pose>
          <geometry><box><size>3.2 0.3 0.05</size></box></geometry>
          <material><ambient>0.06 0.06 0.06 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse><specular>0.05 0.05 0.05 1</specular></material>
        </visual>
        <visual name="rail_left">
          <pose>0 0.165 0.705 0 0 0</pose>
          <geometry><box><size>3.3 0.03 0.07</size></box></geometry>
          <material><ambient>0.5 0.5 0.52 1</ambient><diffuse>0.65 0.65 0.68 1</diffuse></material>
        </visual>
        <visual name="rail_right">
          <pose>0 -0.165 0.705 0 0 0</pose>
          <geometry><box><size>3.3 0.03 0.07</size></box></geometry>
          <material><ambient>0.5 0.5 0.52 1</ambient><diffuse>0.65 0.65 0.68 1</diffuse></material>
        </visual>
        <visual name="leg_1"><pose>-1.5 0 0.335 0 0 0</pose><geometry><box><size>0.06 0.3 0.67</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="leg_2"><pose>-0.5 0 0.335 0 0 0</pose><geometry><box><size>0.06 0.3 0.67</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="leg_3"><pose>0.5 0 0.335 0 0 0</pose><geometry><box><size>0.06 0.3 0.67</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
        <visual name="leg_4"><pose>1.5 0 0.335 0 0 0</pose><geometry><box><size>0.06 0.3 0.67</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Bin rack: table top at z = 0.49 with four open bins -->
    <model name="bin_rack">
      <static>true</static>
      <pose>0 -0.5 0 0 0 0</pose>
      <link name="link">
        <collision name="top"><pose>0 0 0.475 0 0 0</pose><geometry><box><size>0.96 0.26 0.03</size></box></geometry></collision>
        <visual name="top"><pose>0 0 0.475 0 0 0</pose><geometry><box><size>0.96 0.26 0.03</size></box></geometry>
          <material><ambient>0.35 0.3 0.25 1</ambient><diffuse>0.45 0.38 0.3 1</diffuse></material></visual>
        <visual name="leg"><pose>0 0 0.23 0 0 0</pose><geometry><box><size>0.9 0.2 0.46</size></box></geometry>
          <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material></visual>
      </link>
    </model>
    ${bins_sdf}


    <!-- Two ArUco markers (DICT_4X4_50, ids 0 and 1, 80 mm) next to the belt,
         used by calibrate_camera to estimate the camera extrinsics. -->
    ${markers_sdf}

    <!-- Overhead RGB-D camera above the pick zone, looking straight down.
         Image right = +x (direction of belt travel). -->
    <model name="overhead_camera">
      <static>true</static>
      <pose>${camera_pose}</pose>
      <link name="link">
        <visual name="body"><geometry><box><size>0.04 0.12 0.04</size></box></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <sensor name="rgbd" type="rgbd_camera">
          <ignition_frame_id>camera_optical_frame</ignition_frame_id>
          <topic>camera</topic>
          <update_rate>${camera_rate}</update_rate>
          <always_on>true</always_on>
          <camera>
            <horizontal_fov>1.0</horizontal_fov>
            <image><width>640</width><height>480</height><format>R8G8B8</format></image>
            <clip><near>0.1</near><far>3.0</far></clip>
            <noise><type>gaussian</type><mean>0</mean><stddev>${image_noise}</stddev></noise>
            <depth_camera><clip><near>0.1</near><far>3.0</far></clip></depth_camera>
          </camera>
        </sensor>
      </link>
    </model>
    <!-- Optional fixed "showcase" camera for recording videos of the cell (README GIFs) -->
    ${showcase_sdf}

    <model name="camera_mast">
      <static>true</static>
      <link name="link">
        <visual name="pole"><pose>0 1.0 0.85 0 0 0</pose><geometry><cylinder><radius>0.025</radius><length>1.7</length></cylinder></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
        <visual name="arm"><pose>0 0.8 1.6 0 0 0</pose><geometry><box><size>0.04 0.4 0.04</size></box></geometry>
          <material><ambient>0.5 0.5 0.5 1</ambient><diffuse>0.6 0.6 0.6 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>
