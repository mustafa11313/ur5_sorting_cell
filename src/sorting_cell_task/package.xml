<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>sorting_cell_task</name>
  <version>0.1.0</version>
  <description>Decision making for the sorting cell: a py_trees behavior tree that selects parts, plans grasps, drives MoveIt 2 and the conveyor, plus the planning scene and the metrics/evaluation node.</description>
  <maintainer email="mustafa11313@users.noreply.github.com">Mustafa Almohamad</maintainer>
  <license>AGPL-3.0-only</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>vision_msgs</exec_depend>
  <exec_depend>moveit_msgs</exec_depend>
  <exec_depend>shape_msgs</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>sorting_cell_interfaces</exec_depend>
  <exec_depend>py_trees</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
