<?xml version="1.0"?>
<!--
  Simple parallel-jaw gripper (two prismatic fingers), mounted on tool0.
  Frames (z = approach direction, out of the flange):
    gripper_base_link  at tool0
    left/right_finger  slide along +y / -y, joint value = half the opening
    tcp                fingertip grasp point, 0.105 m from tool0
  Max opening is 2 x 0.04 = 0.08 m.
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:property name="gripper_tcp_z" value="0.105"/>

  <xacro:macro name="parallel_gripper" params="parent prefix:=''">
    <joint name="${prefix}gripper_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}gripper_base_link"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
    </joint>

    <link name="${prefix}gripper_base_link">
      <visual>
        <origin xyz="0 0 0.006" rpy="0 0 0"/>
        <geometry><cylinder radius="0.032" length="0.012"/></geometry>
        <material name="gripper_dark"><color rgba="0.15 0.15 0.17 1"/></material>
      </visual>
      <visual>
        <origin xyz="0 0 0.031" rpy="0 0 0"/>
        <geometry><box size="0.05 0.11 0.038"/></geometry>
        <material name="gripper_grey"><color rgba="0.55 0.57 0.6 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <geometry><box size="0.065 0.115 0.05"/></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0.025" rpy="0 0 0"/>
        <mass value="0.6"/>
        <inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0004" iyz="0" izz="0.0008"/>
      </inertial>
    </link>

    <xacro:macro name="finger" params="side sign">
      <joint name="${prefix}${side}_finger_joint" type="prismatic">
        <parent link="${prefix}gripper_base_link"/>
        <child link="${prefix}${side}_finger"/>
        <origin xyz="0 0 0.05" rpy="0 0 0"/>
        <axis xyz="0 ${sign} 0"/>
        <limit lower="0.0" upper="0.04" effort="100" velocity="0.1"/>
      </joint>
      <link name="${prefix}${side}_finger">
        <visual>
          <origin xyz="0 ${sign * 0.006} 0.035" rpy="0 0 0"/>
          <geometry><box size="0.02 0.012 0.07"/></geometry>
          <material name="gripper_dark"/>
        </visual>
        <collision>
          <origin xyz="0 ${sign * 0.006} 0.035" rpy="0 0 0"/>
          <geometry><box size="0.02 0.012 0.07"/></geometry>
        </collision>
        <inertial>
          <origin xyz="0 ${sign * 0.006} 0.035" rpy="0 0 0"/>
          <mass value="0.05"/>
          <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.000005"/>
        </inertial>
      </link>
    </xacro:macro>
    <xacro:finger side="left" sign="1"/>
    <xacro:finger side="right" sign="-1"/>

    <joint name="${prefix}tcp_joint" type="fixed">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}tcp"/>
      <origin xyz="0 0 ${gripper_tcp_z}" rpy="0 0 0"/>
    </joint>
    <link name="${prefix}tcp"/>
  </xacro:macro>
</robot>
