<?xml version="1.0" encoding="UTF-8"?>
<robot name="ur5">
  <group name="ur_manipulator">
    <chain base_link="base_link" tip_link="tcp"/>
  </group>
  <group name="gripper">
    <joint name="left_finger_joint"/>
    <joint name="right_finger_joint"/>
  </group>

  <group_state name="home" group="ur_manipulator">
    <joint name="shoulder_pan_joint" value="0"/>
    <joint name="shoulder_lift_joint" value="-1.5708"/>
    <joint name="elbow_joint" value="1.5708"/>
    <joint name="wrist_1_joint" value="-1.5708"/>
    <joint name="wrist_2_joint" value="-1.5708"/>
    <joint name="wrist_3_joint" value="0"/>
  </group_state>
  <group_state name="open" group="gripper">
    <joint name="left_finger_joint" value="0.04"/>
    <joint name="right_finger_joint" value="0.04"/>
  </group_state>
  <group_state name="closed" group="gripper">
    <joint name="left_finger_joint" value="0.0"/>
    <joint name="right_finger_joint" value="0.0"/>
  </group_state>

  <end_effector name="parallel_gripper" parent_link="tool0" group="gripper" parent_group="ur_manipulator"/>

  <!-- Disabled collision pairs: UR pairs as in ur_moveit_config, plus the gripper -->
  <disable_collisions link1="base_link" link2="base_link_inertia" reason="Adjacent"/>
  <disable_collisions link1="base_link_inertia" link2="shoulder_link" reason="Adjacent"/>
  <disable_collisions link1="shoulder_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="upper_arm_link" reason="Adjacent"/>
  <disable_collisions link1="forearm_link" link2="wrist_1_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_2_link" reason="Adjacent"/>
  <disable_collisions link1="wrist_1_link" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="wrist_2_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="wrist_3_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="wrist_2_link" reason="Never"/>
  <disable_collisions link1="gripper_base_link" link2="left_finger" reason="Adjacent"/>
  <disable_collisions link1="gripper_base_link" link2="right_finger" reason="Adjacent"/>
  <disable_collisions link1="left_finger" link2="right_finger" reason="Never"/>
  <disable_collisions link1="left_finger" link2="wrist_3_link" reason="Never"/>
  <disable_collisions link1="right_finger" link2="wrist_3_link" reason="Never"/>
</robot>
